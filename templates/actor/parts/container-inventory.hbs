{{#each containerPanels}}
<section class="container-inventory-panel" data-container-panel="{{id}}" hidden>
    <header class="container-inventory-heading">
        <h3><i class="fas fa-suitcase"></i> {{name}} – {{localize "HTBAH.ContainerContents"}}</h3>
        <span>{{itemCount}} {{localize "HTBAH.ContainerItemCount"}}</span>
    </header>
    <div class="container-inventory-sections">
        {{#each sections}}
        <section class="items-section card container-items-section" data-type="{{dataset.type}}" data-container-id="{{../id}}">
            <div class="items-header header">
                <div class="item-header item-name">
                    {{localize label}}
                    <div class="dropzone-indicator">
                        <i class="fas fa-arrow-down"></i>
                        <span class="dropzone-text">{{localize "HTBAH.ContainerDropHere"}}</span>
                    </div>
                </div>
                <div class="item-header item-quantity">{{localize "HTBAH.Quantity"}}</div>
                <div class="item-header item-controls"></div>
            </div>
            <ol class="item-list unlist">
                {{#each items}}
                <li class="item" data-item-id="{{_id}}" data-entry-id="{{_id}}"
                    data-item-name="{{name}}" data-item-sort="{{sort}}" data-ungrouped="all"
                    data-grouped="{{type}}" draggable="true">
                    <div class="item-name item-action item-tooltip {{ctx.rollableClass}}" role="button"
                         data-action="itemAction" data-sub-action="roll" data-item-id="{{_id}}"
                         aria-label="{{name}}" draggable="true">
                        <img class="item-image gold-icon {{#if system.icon}}item-svg-image{{/if}}"
                             src="{{#if system.icon}}{{system.icon}}{{else}}{{img}}{{/if}}" alt="{{name}}">
                        <div class="name name-stacked">
                            <span class="title">{{name}}</span>
                            {{#if ctx.subtitle}}<span class="subtitle">{{{ctx.subtitle}}}</span>{{/if}}
                        </div>
                    </div>
                    <div class="item-detail item-quantity">
                        {{#if @root.owner}}
                        <a class="adjustment-button" data-action="adjustQuantity" data-direction="decrease" data-property="system.quantity"><i class="fas fa-minus"></i></a>
                        {{/if}}
                        <input type="text" value="{{system.quantity}}" placeholder="0" data-dtype="Number"
                               data-name="system.quantity" inputmode="numeric" pattern="[0-9+=\-]*" min="0"
                               {{#unless @root.owner}}readonly{{/unless}}>
                        {{#if @root.owner}}
                        <a class="adjustment-button" data-action="adjustQuantity" data-direction="increase" data-property="system.quantity"><i class="fas fa-plus"></i></a>
                        {{/if}}
                    </div>
                    <div class="item-detail item-controls">
                        {{#if @root.editable}}
                        <a class="item-control item-edit" data-action="itemAction" data-sub-action="edit"
                           data-tooltip="HTBAH.ItemEdit" aria-label="{{localize "HTBAH.ItemEdit"}}"><i class="fas fa-edit"></i></a>
                        <a class="item-control item-delete" data-action="itemAction" data-sub-action="delete"
                           data-tooltip="HTBAH.ItemDelete" aria-label="{{localize "HTBAH.ItemDelete"}}"><i class="fas fa-trash"></i></a>
                        {{else}}
                        {{#with ctx.equip}}
                        {{#if applicable}}
                        <a class="item-control item-action {{cls}}" data-action="itemAction" data-sub-action="equip"
                           data-tooltip="{{title}}" aria-label="{{localize title}}" aria-disabled="{{this.disabled}}">
                            <i class="fas fa-shield-halved"></i>
                        </a>
                        {{/if}}
                        {{/with}}
                        {{/if}}
                        <a class="item-control interface-only" data-context-menu aria-label="{{localize "HTBAH.AdditionalControls"}}">
                            <i class="fas fa-ellipsis-vertical"></i>
                        </a>
                    </div>
                </li>
                {{/each}}
                {{#unless items.length}}
                <li class="container-empty-message">{{localize "HTBAH.ContainerEmpty"}}</li>
                {{/unless}}
            </ol>
        </section>
        {{/each}}
    </div>
</section>
{{/each}}
